# Copia este archivo a .env.local y completa con los valores de tu proyecto de Supabase
# (Project Settings → API en el dashboard de supabase.com). Nunca subas .env.local a git.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para scripts locales de una sola vez (ej. sembrar datos), NUNCA se usa en el
# código de la app ni se expone al navegador. No lo pongas en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string de Postgres (Settings → Connect → Direct/Session pooler), solo para
# scripts/run-sql.ts. Igual que arriba: nunca en el código de la app ni en Vercel.
DATABASE_URL=
